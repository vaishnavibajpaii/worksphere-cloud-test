# Copy to .env at project root. Never commit actual secrets.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/worksphere?schema=public"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS_LONG"
APP_ORIGIN="http://localhost:5173"
API_PORT=4000
NODE_ENV=development
# Optional SMTP, required to email password resets in production:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WorkSphere <noreply@example.com>"
# Allow filesystem attachments in local development only; use a durable storage mount in production.
UPLOAD_DIR=./uploads
