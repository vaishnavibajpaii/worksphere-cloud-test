generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
 id String @id @default(cuid())
 name String @default("WorkSphere")
 slug String @unique @default("worksphere")
 createdAt DateTime @default(now())
 users User[]
 branches Branch[]
 departments Department[]
 teams Team[]
 projects Project[]
 settings Setting[]
 masters MasterItem[]
}
model Branch {
 id String @id @default(cuid())
 organizationId String
 name String
 code String
 active Boolean @default(true)
 organization Organization @relation(fields:[organizationId],references:[id])
 users User[]
 @@unique([organizationId,code])
}
model Department {
 id String @id @default(cuid())
 organizationId String
 name String
 code String
 active Boolean @default(true)
 organization Organization @relation(fields:[organizationId],references:[id])
 users User[]
 @@unique([organizationId,code])
}
model Designation {
 id String @id @default(cuid())
 name String @unique
 active Boolean @default(true)
 users User[]
}
model Team {
 id String @id @default(cuid())
 organizationId String
 name String
 active Boolean @default(true)
 organization Organization @relation(fields:[organizationId],references:[id])
 users User[]
 @@unique([organizationId,name])
}
model User {
 id String @id @default(cuid())
 organizationId String
 employeeCode String @unique
 name String
 email String @unique
 passwordHash String
 phone String?
 avatarUrl String?
 primaryRole String @default("EMPLOYEE")
 active Boolean @default(true)
 branchId String?
 departmentId String?
 designationId String?
 teamId String?
 managerId String?
 joinedAt DateTime @default(now())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id])
 branch Branch? @relation(fields:[branchId],references:[id])
 department Department? @relation(fields:[departmentId],references:[id])
 designation Designation? @relation(fields:[designationId],references:[id])
 team Team? @relation(fields:[teamId],references:[id])
 manager User? @relation("Manages",fields:[managerId],references:[id])
 directReports User[] @relation("Manages")
 roles UserRole[]
 sessions AuthSession[]
 reports DailyWorkReport[]
 reviews DailyReportReview[]
 assignments TaskAssignment[]
 timeLogs TaskTimeLog[]
 attendance AttendanceRecord[]
 leaveRequests LeaveRequest[]
 leaveBalances LeaveBalance[]
 notifications Notification[]
 projectOwnership Project[]
 comments TaskComment[]
 auditLogs AuditLog[]
 @@index([organizationId,departmentId])
 @@index([managerId])
}
model Role {
 id String @id @default(cuid())
 code String @unique
 name String
 system Boolean @default(false)
 users UserRole[]
 permissions RolePermission[]
}
model Permission {
 id String @id @default(cuid())
 code String @unique
 description String
 roles RolePermission[]
}
model UserRole {
 userId String
 roleId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
 @@id([userId,roleId])
}
model RolePermission {
 roleId String
 permissionId String
 role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
 permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade)
 @@id([roleId,permissionId])
}
model AuthSession {
 id String @id @default(cuid())
 userId String
 refreshHash String @unique
 expiresAt DateTime
 revokedAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,expiresAt])
}
model PasswordReset {
 id String @id @default(cuid())
 userId String
 tokenHash String @unique
 expiresAt DateTime
 usedAt DateTime?
}
model Project {
 id String @id @default(cuid())
 organizationId String
 name String
 code String
 description String @default("")
 status String @default("ACTIVE")
 startsAt DateTime?
 endsAt DateTime?
 ownerId String
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id])
 owner User @relation(fields:[ownerId],references:[id])
 tasks Task[]
 @@unique([organizationId,code])
}
model Task {
 id String @id @default(cuid())
 projectId String?
 title String
 description String @default("")
 status String @default("TODO")
 priority String @default("MEDIUM")
 progress Int @default(0)
 dueAt DateTime?
 parentId String?
 createdById String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 project Project? @relation(fields:[projectId],references:[id])
 assignments TaskAssignment[]
 comments TaskComment[]
 timeLogs TaskTimeLog[]
 reportEntries DailyReportEntry[]
 @@index([status,dueAt])
}
model TaskAssignment {
 taskId String
 userId String
 assignedAt DateTime @default(now())
 task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id])
 @@id([taskId,userId])
}
model TaskComment {
 id String @id @default(cuid())
 taskId String
 authorId String
 message String
 createdAt DateTime @default(now())
 task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
 author User @relation(fields:[authorId],references:[id])
}
model TaskTimeLog {
 id String @id @default(cuid())
 taskId String
 userId String
 minutes Int
 note String @default("")
 loggedAt DateTime @default(now())
 task Task @relation(fields:[taskId],references:[id])
 user User @relation(fields:[userId],references:[id])
}
model DailyWorkReport {
 id String @id @default(cuid())
 employeeId String
 date DateTime @db.Date
 status String @default("DRAFT")
 remarks String @default("")
 nextDayPlan String @default("")
 totalMinutes Int @default(0)
 currentVersion Int @default(1)
 submittedAt DateTime?
 approvedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 employee User @relation(fields:[employeeId],references:[id])
 entries DailyReportEntry[]
 reviews DailyReportReview[]
 versions ReportVersion[]
 @@unique([employeeId,date])
 @@index([status,date])
}
model DailyReportEntry {
 id String @id @default(cuid())
 reportId String
 taskId String?
 title String
 description String @default("")
 completed String @default("")
 inProgress String @default("")
 pending String @default("")
 blocker String @default("")
 priority String @default("MEDIUM")
 minutes Int @default(0)
 progress Int @default(0)
 attachmentIds Json @default("[]")
 report DailyWorkReport @relation(fields:[reportId],references:[id],onDelete:Cascade)
 task Task? @relation(fields:[taskId],references:[id])
}
model DailyReportReview {
 id String @id @default(cuid())
 reportId String
 reviewerId String
 action String
 comment String @default("")
 createdAt DateTime @default(now())
 report DailyWorkReport @relation(fields:[reportId],references:[id],onDelete:Cascade)
 reviewer User @relation(fields:[reviewerId],references:[id])
}
model ReportVersion {
 id String @id @default(cuid())
 reportId String
 version Int
 snapshot Json
 createdAt DateTime @default(now())
 report DailyWorkReport @relation(fields:[reportId],references:[id],onDelete:Cascade)
 @@unique([reportId,version])
}
model AttendanceRecord {
 id String @id @default(cuid())
 userId String
 date DateTime @db.Date
 checkIn DateTime?
 checkOut DateTime?
 status String @default("PRESENT")
 note String @default("")
 user User @relation(fields:[userId],references:[id])
 @@unique([userId,date])
}
model LeaveType {
 id String @id @default(cuid())
 code String @unique
 name String
 daysPerYear Int @default(12)
 active Boolean @default(true)
 requests LeaveRequest[]
 balances LeaveBalance[]
}
model LeaveBalance {
 id String @id @default(cuid())
 userId String
 typeId String
 year Int
 allotted Float @default(0)
 used Float @default(0)
 user User @relation(fields:[userId],references:[id])
 type LeaveType @relation(fields:[typeId],references:[id])
 @@unique([userId,typeId,year])
}
model LeaveRequest {
 id String @id @default(cuid())
 userId String
 typeId String
 startDate DateTime @db.Date
 endDate DateTime @db.Date
 days Float
 reason String
 status String @default("PENDING")
 reviewedById String?
 reviewComment String?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id])
 type LeaveType @relation(fields:[typeId],references:[id])
 @@index([status,startDate])
}
model Holiday {
 id String @id @default(cuid())
 name String
 date DateTime @db.Date
 branchId String?
 @@unique([name,date])
}
model Announcement {
 id String @id @default(cuid())
 title String
 body String
 audience String @default("ALL")
 authorId String
 createdAt DateTime @default(now())
}
model Notification {
 id String @id @default(cuid())
 userId String
 title String
 body String
 link String?
 readAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,readAt,createdAt])
}
model MasterItem {
 id String @id @default(cuid())
 organizationId String
 category String
 code String
 label String
 metadata Json @default("{}")
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id])
 @@unique([organizationId,category,code])
}
model Setting {
 id String @id @default(cuid())
 organizationId String
 key String
 value Json
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id])
 @@unique([organizationId,key])
}
model AuditLog {
 id String @id @default(cuid())
 actorId String?
 action String
 entity String
 entityId String?
 detail Json?
 createdAt DateTime @default(now())
 actor User? @relation(fields:[actorId],references:[id])
 @@index([createdAt,action])
}
model FileMetadata {
 id String @id @default(cuid())
 ownerId String
 originalName String
 contentType String
 bytes Int
 storageKey String
 createdAt DateTime @default(now())
}
